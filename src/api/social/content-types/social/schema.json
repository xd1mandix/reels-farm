{
  "kind": "collectionType",
  "collectionName": "socials",
  "info": {
    "singularName": "social",
    "pluralName": "socials",
    "displayName": "socials"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "youtube",
        "tiktok",
        "instagram"
      ]
    },
    "accounts": {
      "type": "relation",
