{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "posts"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "link": {
      "type": "string",
      "required": false
    },
    "description": {
      "type": "text",
      "required": true
    },
    "publishing": {
      "type": "datetime"
    },
    "publish_status": {
      "type": "enumeration",
      "required": false,
      "default": "scheduled",
      "enum": [
        "scheduled",
        "published"
      ]
    },
    "account": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::account.account",
      "inversedBy": "posts"
    },
    "video": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::video.video",
      "inversedBy": "posts"
    }
  }
}
